    {
      "name": "B — CRUD and aggregated responses",
      "description": "Creates a temporary user, post and interaction; tests GET, POST and PUT; saves generated IDs automatically.",
      "item": [
        {
          "name": "08 POST create test user",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "users"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{testUsername}}\",\n  \"email\": \"{{testEmail}}\",\n  \"displayName\": \"Milestone 2 Tester\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Creates a unique test user each run, saves ID to collection variables."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const suffix = Date.now().toString();",
                  "pm.collectionVariables.set(\"testUsername\", \"ms2test_\" + suffix);",
                  "pm.collectionVariables.set(\"testEmail\", \"ms2test_\" + suffix + \"@example.com\");"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
                  "pm.test(\"Location header\", () => pm.expect(pm.response.headers.get(\"Location\")).to.include(\"/api/users/\"));",
                  "pm.test(\"User ID saved\", () => {const r = pm.response.json(); pm.expect(r.id).to.be.a(\"number\"); pm.collectionVariables.set(\"testUserId\", r.id);});"
                ]
              }
            }
          ],
          "response": []
        },
